# Salin file ini menjadi .env.local lalu isi nilai yang sesuai.

# URL produksi situs. Wajib diisi secara eksplisit saat deploy (jangan ditebak).
NEXT_PUBLIC_SITE_URL=https://surabaya-drive.vercel.app

# Nomor WhatsApp tujuan dalam format internasional (62…), tanpa tanda "+".
# Nomor ini dipakai untuk membangun tautan wa.me pada ringkasan pemesanan.
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
